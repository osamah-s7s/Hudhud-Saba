# Copy to .env.local for local development; set the same names in Vercel
# (Project Settings -> Environment Variables). Server-only: never prefix with NEXT_PUBLIC_.

# --- Storage (required): every response is saved in Supabase ---------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret API key (starts with "sb_secret_"). Full access to the database:
# keep it secret, server-only, and never use the publishable key here.
SUPABASE_SECRET_KEY=change-me

# --- Admin panel (/admin): one account, defined here ------------------------
ADMIN_USERNAME=admin
# Use a long, unique password.
ADMIN_PASSWORD=change-me
# Signs the admin session cookie. Use a long random string, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs the admin out.
ADMIN_SESSION_SECRET=change-me

# --- Email copy (optional) ---------------------------------------------------
# Leave these empty to store responses only. When they are all set, each
# response is also emailed; an email failure never loses a response.
# SMTP server hostname from your email provider (required for email).
SMTP_HOST=
# SMTP port: 587 (STARTTLS, default) or 465 (implicit TLS).
SMTP_PORT=587
# "true" for implicit TLS (port 465); leave empty to derive from SMTP_PORT.
SMTP_SECURE=
# SMTP login username (required for email).
SMTP_USER=
# SMTP password or app password (required for email). Keep it secret.
SMTP_PASS=
# Sender address for response emails; defaults to SMTP_USER if empty.
SURVEY_FROM_EMAIL=
# Address that receives each response email (required for email).
SURVEY_TO_EMAIL=

# Optional: public site URL for social-share metadata (Vercel URLs are used automatically).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

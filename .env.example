# Copy to .env.local for local development; set the same names in Vercel
# (Project Settings -> Environment Variables). Server-only: never prefix with NEXT_PUBLIC_.

# SMTP server hostname from your email provider (required).
SMTP_HOST=smtp.example.com
# SMTP port: 587 (STARTTLS, default) or 465 (implicit TLS).
SMTP_PORT=587
# "true" for implicit TLS (port 465); leave empty to derive from SMTP_PORT.
SMTP_SECURE=
# SMTP login username (required).
SMTP_USER=survey@example.com
# SMTP password or app password (required). Keep it secret.
SMTP_PASS=change-me
# Sender address for response emails; defaults to SMTP_USER if empty.
SURVEY_FROM_EMAIL=
# Address that receives each survey response (required). Placeholder - replace.
SURVEY_TO_EMAIL=responses@example.com

# Optional: public site URL for social-share metadata (Vercel URLs are used automatically).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
